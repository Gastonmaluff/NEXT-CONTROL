rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null;
    }

    function userDoc() {
      return firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data;
    }

    function active() {
      return signedIn()
        && firestore.exists(/databases/(default)/documents/users/$(request.auth.uid))
        && userDoc().active == true;
    }

    function isManagement() {
      return active()
        && userDoc().role in ["admin", "gerencia", "administracion"];
    }

    function isAdmin() {
      return active() && userDoc().role == "admin";
    }

    function isAssignedToWork(obraId) {
      return active()
        && userDoc().assignedWorkIds is list
        && obraId in userDoc().assignedWorkIds;
    }

    function isWorkCreator(obraId) {
      return active()
        && firestore.exists(/databases/(default)/documents/obras/$(obraId))
        && firestore.get(/databases/(default)/documents/obras/$(obraId)).data.createdBy == request.auth.uid;
    }

    function canUseWork(obraId) {
      return isManagement() || isAssignedToWork(obraId) || isWorkCreator(obraId);
    }
    function canReadProductionArtifact(orderId) {
      return isManagement() || (active()
        && firestore.exists(/databases/(default)/documents/ordenesProduccion/$(orderId))
        && ((userDoc().role in ["produccion", "taller"] && firestore.get(/databases/(default)/documents/ordenesProduccion/$(orderId)).data.get("assignedToUid", "") == request.auth.uid)
          || (firestore.get(/databases/(default)/documents/ordenesProduccion/$(orderId)).data.get("fieldReferencesApproved", false) == true && isAssignedToWork(firestore.get(/databases/(default)/documents/ordenesProduccion/$(orderId)).data.get("obraId", "")))));
    }
    function productionFilesUnreferenced(orderId) {
      return !firestore.exists(/databases/(default)/documents/importacionesInstalacion/$(orderId));
    }

    function canUploadWorkImage(obraId) {
      return isManagement()
        || isWorkCreator(obraId)
        || (
          active()
          && userDoc().role in ["produccion", "taller"]
        )
        || (
          active()
          && userDoc().role in ["supervisor", "fiscalizador", "encargado", "instalador", "equipo_campo", "campo"]
          && isAssignedToWork(obraId)
        );
    }

    function isAllowedImage() {
      return request.resource != null
        && request.resource.contentType in ["image/jpeg", "image/png", "image/webp"];
    }

    function isAllowedImageSize() {
      return request.resource != null
        && request.resource.size <= 8 * 1024 * 1024;
    }

    match /obras/{obraId}/render/{fileName} {
      allow read: if canUseWork(obraId);
      allow create, update: if canUploadWorkImage(obraId)
        && isAllowedImage()
        && isAllowedImageSize();
      allow delete: if canUploadWorkImage(obraId);
    }

    match /obras/{obraId}/{allPaths=**} {
      allow read: if canUseWork(obraId);
      allow create, update: if canUploadWorkImage(obraId)
        && isAllowedImage()
        && isAllowedImageSize();
      allow delete: if canUploadWorkImage(obraId);
    }

    match /ordenes-produccion/{orderId}/adjuntos/{fileName} {
      allow read: if canReadProductionArtifact(orderId);
      allow create, update: if request.resource != null && isManagement() && (resource == null || productionFilesUnreferenced(orderId))
        && request.resource.size <= 15 * 1024 * 1024;
      allow delete: if isAdmin() && productionFilesUnreferenced(orderId);
    }

    match /ordenes-produccion/{orderId}/{allPaths=**} {
      allow read: if canReadProductionArtifact(orderId);
      allow create, update: if request.resource != null && isManagement() && (resource == null || productionFilesUnreferenced(orderId))
        && request.resource.contentType in ["application/pdf", "image/png", "image/jpeg", "image/webp"]
        && request.resource.size <= 15 * 1024 * 1024;
      allow delete: if isAdmin() && productionFilesUnreferenced(orderId);
    }

    match /installation-evidence/{unitId}/{fileName} {
      function unit() {
        return firestore.get(/databases/(default)/documents/unidadesInstalacion/$(unitId)).data;
      }
      function assignedInstallationWorker() {
        return active() && userDoc().role in ["instalador", "equipo_campo", "campo"]
          && isAssignedToWork(unit().obraId)
          && userDoc().assignedTeamIds is list
          && unit().teamId in userDoc().assignedTeamIds;
      }
      allow read: if isAdmin() || (active() && isAssignedToWork(unit().obraId)
        && userDoc().role in ["instalador", "equipo_campo", "campo"]
        && userDoc().assignedTeamIds is list
        && (unit().teamId in userDoc().assignedTeamIds || unit().creditedTeamId in userDoc().assignedTeamIds));
      allow create: if resource == null && (isAdmin() || assignedInstallationWorker())
        && isAllowedImage() && isAllowedImageSize();
      allow update, delete: if false;
    }
    match /installation-support/{unitId}/{fileName} {
      allow read: if isAdmin() || (active() && firestore.get(/databases/(default)/documents/unidadesInstalacion/$(unitId)).data.get("fieldReferencesApproved", false) == true && isAssignedToWork(firestore.get(/databases/(default)/documents/unidadesInstalacion/$(unitId)).data.obraId));
      allow create: if resource == null && isAdmin() && request.resource != null
        && request.resource.contentType in ["application/pdf", "image/jpeg", "image/png", "image/webp"]
        && request.resource.size <= 15 * 1024 * 1024;
      allow update, delete: if false;
    }


    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
